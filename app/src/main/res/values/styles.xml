<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ════════ STYLE PARENT DE BASE ════════ -->
    <style name="TextStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/inter_tight</item>
        <item name="android:textColor">@color/ink_1</item>
    </style>

    <!-- ════════ TEXTES ════════ -->

    <style name="TextStyle.H1">
        <item name="android:textSize">@dimen/text_4xl</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextStyle.H2">
        <item name="android:textSize">@dimen/text_2xl</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextStyle.H3">
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextStyle.H4">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.Body">
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextStyle.Caption">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextStyle.Eyebrow">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/ink_3</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- ════════ BOUTONS ════════ -->

    <!-- Primary -->
    <style name="Button.Primary"
        parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/olive_500</item>
        <item name="android:textColor">@color/paper</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:paddingStart">@dimen/btn_padding_h</item>
        <item name="android:paddingEnd">@dimen/btn_padding_h</item>
        <item name="android:paddingTop">@dimen/btn_padding_v</item>
        <item name="android:paddingBottom">@dimen/btn_padding_v</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Primary Large -->
    <style name="Button.Primary.Large">
        <item name="android:paddingStart">@dimen/btn_padding_h_lg</item>
        <item name="android:paddingEnd">@dimen/btn_padding_h_lg</item>
        <item name="android:paddingTop">@dimen/btn_padding_v_lg</item>
        <item name="android:paddingBottom">@dimen/btn_padding_v_lg</item>
        <item name="android:minHeight">@dimen/btn_height_lg</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="cornerRadius">10dp</item>
    </style>

    <!-- Secondary -->
    <style name="Button.Secondary"
        parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/ink_1</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:paddingStart">@dimen/btn_padding_h</item>
        <item name="android:paddingEnd">@dimen/btn_padding_h</item>
        <item name="android:paddingTop">@dimen/btn_padding_v</item>
        <item name="android:paddingBottom">@dimen/btn_padding_v</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Ghost -->
    <style name="Button.Ghost"
        parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:paddingStart">@dimen/btn_padding_h</item>
        <item name="android:paddingEnd">@dimen/btn_padding_h</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Danger -->
    <style name="Button.Danger"
        parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/status_err_fg</item>
        <item name="android:textSize">@dimen/text_md</item>
        <item name="android:paddingStart">@dimen/btn_padding_h</item>
        <item name="android:paddingEnd">@dimen/btn_padding_h</item>
        <item name="android:minHeight">@dimen/btn_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- ════════ INPUTS ════════ -->

    <style name="Input.Default"
        parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/line</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/ink_4</item>
        <item name="android:textColorHint">@color/ink_4</item>
        <item name="boxStrokeErrorColor">@color/status_err_fg</item>
        <item name="errorTextColor">@color/status_err_fg</item>
    </style>

    <!-- ════════ CARDS ════════ -->

    <style name="Card.Default"
        parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- ════════ APPBAR ════════ -->

    <style name="AppBar.Default"
        parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/paper</item>
        <item name="android:minHeight">@dimen/appbar_height</item>
        <item name="titleTextColor">@color/ink_1</item>
        <item name="titleTextAppearance">@style/TextStyle.H3</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>