<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- ════════ APPBAR ════════ -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/AppBar.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvToolbarTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIT Pointage"
                style="@style/TextStyle.H3"/>

            <TextView
                android:id="@+id/tvToolbarSousTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administration"
                style="@style/TextStyle.Caption"/>

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"/>

    <!-- ════════ CONTENU ════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/space_6"
            android:paddingBottom="@dimen/space_10">

            <!-- ════════ SECTION UTILISATEURS ════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UTILISATEURS"
                style="@style/TextStyle.Eyebrow"
                android:layout_marginBottom="@dimen/space_3"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="@dimen/space_6">

                <!-- Créer utilisateur -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCreerUtilisateur"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textSize="24sp"
                            android:textColor="@color/olive_500"
                            android:layout_marginBottom="@dimen/space_1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Créer"
                            style="@style/TextStyle.H4"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Utilisateur"
                            style="@style/TextStyle.Caption"
                            android:gravity="center"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Liste utilisateurs -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardListeUtilisateurs"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="≡"
                            android:textSize="24sp"
                            android:textColor="@color/ink_3"
                            android:layout_marginBottom="@dimen/space_1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Liste"
                            style="@style/TextStyle.H4"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Utilisateurs"
                            style="@style/TextStyle.Caption"
                            android:gravity="center"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ════════ SECTION BADGES ════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BADGES ET PERMISSIONS"
                style="@style/TextStyle.Eyebrow"
                android:layout_marginBottom="@dimen/space_3"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="@dimen/space_6">

                <!-- Générer badge -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGenererBadge"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⊞"
                            android:textSize="24sp"
                            android:textColor="@color/olive_500"
                            android:layout_marginBottom="@dimen/space_1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Générer"
                            style="@style/TextStyle.H4"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Badge QR"
                            style="@style/TextStyle.Caption"
                            android:gravity="center"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Créer permission -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCreerPermission"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋"
                            android:textSize="24sp"
                            android:layout_marginBottom="@dimen/space_1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Créer"
                            style="@style/TextStyle.H4"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Permission"
                            style="@style/TextStyle.Caption"
                            android:gravity="center"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ════════ SECTION RAPPORTS ════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAPPORTS"
                style="@style/TextStyle.Eyebrow"
                android:layout_marginBottom="@dimen/space_3"/>

            <!-- Présence du jour -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresenceJour"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feuille de présence du jour"
                android:layout_marginBottom="@dimen/space_3"/>

            <!-- Retardataires -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetardataires"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Retardataires"
                android:layout_marginBottom="@dimen/space_3"/>

            <!-- Permissions en cours -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPermissionsEnCours"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permissions en cours"
                android:layout_marginBottom="@dimen/space_8"/>

            <!-- ════════ SECTION HORAIRES ════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIGURATION"
                style="@style/TextStyle.Eyebrow"
                android:layout_marginBottom="@dimen/space_3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHoraires"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gérer les horaires"
                android:layout_marginBottom="@dimen/space_3"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>