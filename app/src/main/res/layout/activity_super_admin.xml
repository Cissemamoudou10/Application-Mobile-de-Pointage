<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- ════════ APPBAR ════════ -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        style="@style/AppBar.Default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvToolbarTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIT Pointage"
                style="@style/TextStyle.H3"/>

            <TextView
                android:id="@+id/tvToolbarSousTitre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Super Administration"
                style="@style/TextStyle.Caption"/>

        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line"/>

    <!-- ════════ CONTENU ════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingTop="@dimen/space_6"
            android:paddingBottom="@dimen/space_10">

            <!-- ════════ ALERTES ════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAlertes"
                style="@style/Card.Default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/space_5">

                    <!-- Icône alerte -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔔"
                        android:textSize="28sp"
                        android:layout_marginEnd="@dimen/space_4"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alertes"
                            style="@style/TextStyle.H4"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tvNombreAlertes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chargement..."
                            style="@style/TextStyle.Caption"/>

                    </LinearLayout>

                    <!-- Badge nombre alertes -->
                    <TextView
                        android:id="@+id/tvBadgeAlertes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/paper"
                        android:background="@drawable/bg_badge_alerte"
                        android:paddingStart="@dimen/space_2"
                        android:paddingEnd="@dimen/space_2"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        style="@style/TextStyle.Caption"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ════════ SECTION COMPTES ════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GESTION DES COMPTES"
                style="@style/TextStyle.Eyebrow"
                android:layout_marginBottom="@dimen/space_3"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="@dimen/space_6">

                <!-- Créer Admin -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCreerAdmin"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textSize="24sp"
                            android:textColor="@color/olive_500"
                            android:layout_marginBottom="@dimen/space_1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Créer"
                            style="@style/TextStyle.H4"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admin"
                            style="@style/TextStyle.Caption"
                            android:gravity="center"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Créer Contrôleur -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCreerControleur"
                    style="@style/Card.Default"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="@dimen/space_2"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/space_3">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textSize="24sp"
                            android:textColor="@color/ink_3"
                            android:layout_marginBottom="@dimen/space_1"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Créer"
                            style="@style/TextStyle.H4"
                            android:gravity="center"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contrôleur"
                            style="@style/TextStyle.Caption"
                            android:gravity="center"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ════════ SECTION RAPPORTS GLOBAUX ════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RAPPORTS GLOBAUX"
                style="@style/TextStyle.Eyebrow"
                android:layout_marginBottom="@dimen/space_3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPresenceGlobale"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Présence globale"
                android:layout_marginBottom="@dimen/space_3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJournalPertes"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Journal des pertes"
                android:layout_marginBottom="@dimen/space_3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJournalAdmins"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activité des admins"
                android:layout_marginBottom="@dimen/space_8"/>

            <!-- ════════ SECTION SYSTÈME ════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTÈME"
                style="@style/TextStyle.Eyebrow"
                android:layout_marginBottom="@dimen/space_3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnParametres"
                style="@style/Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paramètres système"
                android:layout_marginBottom="@dimen/space_3"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>